# Copy to .env.local for Next.js. On Vercel, add the SAME names
# (Project → Settings → Environment Variables). Restart `next dev` after edits.
#
# Never use NEXT_PUBLIC_ on these. Mongo, Auth, Cloudinary, and admin
# credentials must stay server-only.

# Atlas: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
# Local: mongodb://127.0.0.1:27017
# If the password has @ # / % &, URL-encode it first.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"

# Required on Vercel. Generate with: openssl rand -base64 32
# AUTH_SECRET is the Auth.js v5 name. NEXTAUTH_SECRET also works.
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"
ADMIN_EMAIL="admin@veloria.legal"
ADMIN_PASSWORD="admin123"

# Cloudinary (images max 10MB)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="veloria"
